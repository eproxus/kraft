{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:best-practices"],
    "minimumReleaseAge": "14 days",
    "gitIgnoredAuthors": [
        "41898282+github-actions[bot]@users.noreply.github.com"
    ],
    "packageRules": [
        {
            "matchUpdateTypes": ["minor", "patch", "digest"],
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "squash",
            "platformAutomerge": false
        },
        {
            "description": "Digests have no release timestamp",
            "matchUpdateTypes": ["digest"],
            "minimumReleaseAge": null
        },
        {
            "matchPackageNames": ["cowboy", "cowlib"],
            "groupName": "cowboy"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)rebar\\.config$/"
            ],
            "matchStrings": [
                "\\{\\s*(?<depName>[a-z][a-zA-Z0-9_@']*)\\s*,\\s*\"(?<currentValue>(?:~>\\s*)?[0-9a-zA-Z0-9_.-]+)\"(?:\\s*,\\s*\\{pkg,\\s*[a-z][a-zA-Z0-9_@']*\\})?\\s*\\}"
            ],
            "matchStringsStrategy": "any",
            "depNameTemplate": "{{depName}}",
            "currentValueTemplate": "{{currentValue}}",
            "datasourceTemplate": "hex",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)rebar\\.config$/"
            ],
            "matchStrings": [
                "\\{\\s*(?<depName>[a-z][a-zA-Z0-9_@']*)\\s*,\\s*\\{\\s*(?<depType>git|git_subdir)\\s*,\\s*\"(?<packageName>[^\"]+)\"\\s*,(?:(?:\\{(?:branch|ref)\\s*,\\\"[^\\\"]+\\\"\\})|(?:\\{tag\\s*,\\\"(?<currentValue>[^\\\"\\s]+)\\\"\\}))(?:\\s*,\\\"[^\\\"]*\\\")?(?:\\s*,\\{[^\\}]*\\})*\\s*\\}\\s*\\}"
            ],
            "matchStringsStrategy": "any",
            "depNameTemplate": "{{depName}}",
            "packageNameTemplate": "{{packageName}}",
            "currentValueTemplate": "{{currentValue}}",
            "datasourceTemplate": "git-tags",
            "versioningTemplate": "semver"
        }
    ]
}
